{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.desktop.mnour.dev" }],
      "destination": "/admin.html",
      "permanent": false
    }
  ]
}
