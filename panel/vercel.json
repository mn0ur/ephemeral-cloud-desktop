{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.desktop.mnour.dev" }],
      "destination": "/admin.html"
    },
    {
      "source": "/app.js",
      "has": [{ "type": "host", "value": "admin.desktop.mnour.dev" }],
      "destination": "/admin.js"
    }
  ]
}
