{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "desktop.mnour.dev"
        }
      ],
      "destination": "https://desktop.sihaab.com/:path",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.desktop.mnour.dev"
        }
      ],
      "destination": "https://admin.sihaab.com/:path",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.sihaab.com"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    }
  ]
}
